{
    "name": "@swc/cli",
    "version": "0.7.7",
    "description": "CLI for the swc project",
    "main": "lib/swc/index.js",
    "scripts": {
        "prepublishOnly": "pnpm build",
        "types": "tsc",
        "types:watch": "tsc --watch",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "format:src": "prettier --write src",
        "format:examples": "prettier --write examples",
        "format": "pnpm format:src && pnpm format:examples",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "JEST_COVERAGE=true jest --coverage"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/swc-project/pkgs.git"
    },
    "keywords": [
        "swc",
        "cli",
        "babel",
        "es6",
        "transpile",
        "transpiler",
        "compiler",
        "javascript"
    ],
    "author": "강동윤 <kdy1997.dev@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/swc-project/pkgs/issues"
    },
    "homepage": "https://github.com/swc-project/pkgs",
    "engines": {
        "node": ">= 16.14.0"
    },
    "bin": {
        "swc": "./bin/swc.js",
        "swcx": "./bin/swcx.js",
        "spack": "./bin/spack.js"
    },
    "dependencies": {
        "@swc/counter": "workspace:^",
        "@xhmikosr/bin-wrapper": "^14.5.2",
        "commander": "^15.0.0",
        "minimatch": "^11.0.2",
        "piscina": "^5.3.2",
        "semver": "^7.8.5",
        "slash": "5.1.0",
        "source-map": "^0.8.0",
        "tinyglobby": "^0.2.17"
    },
    "devDependencies": {
        "@swc/cli": "0.8.2",
        "@swc/core": "^1.16.20",
        "@swc/jest": "workspace:^",
        "@swc/types": "^0.1.28",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/semver": "^7.8.0",
        "chokidar": "^6.0.0",
        "deepmerge": "^4.3.1",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "typescript": "~7.0.2"
    },
    "peerDependencies": {
        "@swc/core": "^1.16.20",
        "chokidar": "^6.0.0"
    },
    "peerDependenciesMeta": {
        "chokidar": {
            "optional": true
        }
    },
    "files": [
        "bin",
        "lib"
    ]
